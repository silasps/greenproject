# Supabase — crie um projeto gratuito em https://supabase.com e cole aqui
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (e-mail transacional via SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
EMAIL_FROM="Green Project Engenharia <engenharia@greenproject.com.br>"

# Telefone/WhatsApp da empresa não é env var — é editável pela gerência em
# /painel/site (tabela dados_empresa).

# URL pública do site, usada para montar links de verificação de laudo/proposta
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do cron de alertas de vencimento (Vercel manda esse valor no header
# Authorization automaticamente — gere uma string aleatória e cadastre igual
# nas duas pontas: aqui e em Settings > Environment Variables no Vercel).
CRON_SECRET=

